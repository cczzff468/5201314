# ===== 账号系统（注册审核/邀请码/双登录）=====
# 会话签名密钥（HMAC，泄露则所有登录态失效，轮换即全员下线）
AUTH_SECRET=132be627e1798c16c36b511ce55cdc578347c149b01901de2ccbdd6e46f8594f
# QQ邮箱 SMTP 发信账号（完整邮箱地址，如 123456@qq.com）——后续自行填入
QQ_SMTP_USER=
# QQ邮箱 SMTP 授权码（QQ邮箱 设置→账户→开启IMAP/SMTP 后生成，与QQ密码不同）——后续自行填入
QQ_SMTP_AUTH_CODE=
# 超级管理员白名单（多个用英文逗号分隔，如 a@qq.com,b@qq.com）——后续自行填入
ADMIN_QQ_EMAILS=
