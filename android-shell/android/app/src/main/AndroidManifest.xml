<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- 屏幕捕获前台服务（Android 14+ 强制 mediaProjection 类型声明） -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 媒体感知：读取音乐 App 的媒体通知（歌名/歌手/播放状态；「通知使用权」授权后系统绑定） -->
        <service
            android:name=".MediaListenerService"
            android:label="正在收听检测"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- v1.5 Mobile Agent：中文输入引擎（无 UI 的 IME，shell ime set 切入后经广播 commitText 注入中文/emoji；
             仅在 Agent 任务执行期间被切换启用，结束后恢复原输入法） -->
        <service
            android:name=".AdbImeService"
            android:label="AI Phone 输入引擎"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- v1.9.43 吃醋守护前台服务（specialUse 类型）：真机模式「吃醋锁」的原生兜底——
             WebView 被杀/冻结时独立完成「锁到期 pm unsuspend 自动解锁 + dumpsys 强解检测」，
             事件落盘等 JS 醒来取走（见 JealousyGuardService.java） -->
        <service
            android:name=".JealousyGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Android 14+ 强制：specialUse 类型必须声明子类型（用途说明，供系统/审核识别） -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="companion_jealousy_guard" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Shizuku 绑定提供器（时长数据源「Shizuku 模式」：以 shell 权限读系统 usagestats 账本，
             免「使用情况」授权；需用户另装 Shizuku APP 并激活，激活失效时自动降级标准模式） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 真机感知：使用情况统计（AppOps 特殊权限，运行时引导到系统设置开启） -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 分App列表/应用名解析需要（Android 11+ 包可见性；Cap-go queryAllPackages 同源） -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 屏幕捕获前台服务（Android 9+ / 14+ 要求） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- v1.9.43 吃醋守护前台服务（specialUse 类型需配对声明，Android 14+） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v1.6.1 语音唤起修复：WebView 的 getUserMedia 录音需要 RECORD_AUDIO（危险权限，运行时弹系统授权框）。
         未声明时 requestPermissions 被系统静默拒绝（永不弹窗）→ 前端一直报「无法使用麦克风」。
         MODIFY_AUDIO_SETTINGS 为普通权限，供 AudioContext 波形采样/回声处理使用。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- v1.9.36 权限给予页：位置运行时权限（危险权限，弹系统授权框；Shizuku 通道 pm grant 亦需要 Manifest 先声明） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
</manifest>
