<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- 屏幕捕获前台服务（Android 14+ 强制 mediaProjection 类型声明；无障碍截屏的备选通道） -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 媒体+通知感知：读取音乐 App 的媒体通知与最近通知环形缓冲（「通知使用权」授权后系统绑定） -->
        <service
            android:name=".MediaListenerService"
            android:label="正在收听检测"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- v2.0.0 AI 无障碍服务（去 Shizuku 化核心）：静默截屏（API 30+）/ 模拟点击与滑动 /
             全局按键 / 文本注入 / 前台应用事件流追踪。用户在系统设置 › 无障碍 手动开启。 -->
        <service
            android:name=".AiAccessibilityService"
            android:label="AI 手机操控与感知"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- v2.0.0 应用锁定遮罩服务（替代 pm suspend）：UsageStats 3s 轮询前台应用 +
             SYSTEM_ALERT_WINDOW 全屏遮罩拦截（AI 质问文案 + 回到桌面按钮），到期自动解锁，
             事件落盘供 JS 对账 -->
        <service
            android:name=".LockOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Android 14+ 强制：specialUse 类型必须声明子类型 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="companion_app_lock_guard" />
        </service>

        <!-- v2.1.0 常驻守护前台服务（防杀后台）：状态栏常驻「AI Phone 正在守候」，
             监控/查岗/吃醋锁后台进程不被系统轻易回收；Android 14+ 强制 specialUse 类型声明 -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="companion_keepalive_guard" />
        </service>

        <!-- v2.1.0 开机自启动：手机重启后自动拉起常驻守护 + 重梳重启前还活跃的吃醋锁
             （需 RECEIVE_BOOT_COMPLETED 权限；国产 ROM 需在系统设置里允许自启动） -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 真机感知：使用情况统计（AppOps 特殊权限，运行时引导到系统设置开启）——
         前台应用轮询（应用锁定）与使用时长共用 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 分App列表/应用名解析需要（Android 11+ 包可见性） -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 全屏遮罩拦截（应用锁定）：在其他应用上层显示 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务（屏幕捕获 / 应用锁定守护） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 电池优化豁免（设置 › 权限给予；后台守护不被 Doze 限制） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- v1.6.1 语音唤起修复：WebView 的 getUserMedia 录音需要 RECORD_AUDIO（危险权限） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- v1.9.36 位置运行时权限（危险权限，弹系统授权框） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- v2.0.0 读取短信（getRecentSMS 工具 / 权限中心） -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- v2.0.0 通讯录读写（权限中心） -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- v2.0.0 日历读写（权限中心） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- v2.0.0 闹钟与计时器（精确闹钟；API 31+ 默认拒绝需引导到系统授权页） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- v2.1.0 开机自启动：重启后 BootReceiver 自动拉起守护服务（普通权限，安装即授予；
         国产 ROM 的自启动管理需用户在系统设置里另行允许） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v2.1.0 修改系统设置：AI 调节屏幕亮度（SCREEN_BRIGHTNESS）/ 切手动亮度模式；
         铃声静音经 AudioManager（设置静音在部分 ROM 需勿扰访问，失败自动降级零铃声量） -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- v2.0.0 文件读写与媒体访问（33+ 细分媒体权限组；32- 旧存储权限） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
</manifest>
